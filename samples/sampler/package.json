{
  "name": "limestone-sampler",
  "version": "1.12.0",
  "description": "Component and QA samples for Limestone",
  "private": true,
  "main": "index.js",
  "scripts": {
    "bootstrap": "enact bootstrap",
    "clean": "enact clean",
    "cleanall": "enact clean --all",
    "lint": "enact lint --strict",
    "test": "echo \"No test suite\" && exit 0",
    "pack": "storybook build -c .storybook -o dist",
    "pack-qa": "storybook build -c .qa-storybook -o dist",
    "serve": "storybook dev -p 8080 -c .storybook --ci",
    "serve-qa": "storybook dev -p 8080 -c .qa-storybook --ci",
    "postinstall": "patch-package"
  },
  "license": "Apache-2.0",
  "enact": {
    "theme": "limestone"
  },
  "dependencies": {
    "@enact/core": "^5.6.0",
    "@enact/i18n": "^5.6.0",
    "@enact/limestone": "../../",
    "@enact/spotlight": "^5.6.0",
    "@enact/storybook-utils": "^8.1.0",
    "@enact/ui": "^5.6.0",
    "@github-ui/storybook-addon-performance-panel": "^1.3.1",
    "@storybook/react-webpack5": "10.6.6",
    "classnames": "^2.5.1",
    "ilib": "^14.22.0",
    "patch-package": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-ga4": "^3.0.1",
    "react-is": "^19.3.1",
    "storybook": "10.6.6",
    "storybook-addon-pseudo-states": "10.6.6"
  },
  "overrides": {
    "webpack-dev-middleware": "^7.4.6"
  }
}
